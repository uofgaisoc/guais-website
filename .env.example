# Copy this file to .env.local and fill it in. Never commit .env.local

# From https://www.sanity.io/manage -> your project -> the project ID is shown at the top
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-11

# Any long random string. Must match the secret you put in the Sanity webhook (see README).
SANITY_REVALIDATE_SECRET=
